{
  "name": "album-githubpage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/node-compat.mjs ./node_modules/vite/bin/vite.js --configLoader native",
    "build": "node --import ./scripts/node-compat.mjs ./node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "optimize:photos": "node scripts/optimize_photos.mjs",
    "optimize:cameras": "node scripts/optimize_cameras.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "image-size": "^2.0.2",
    "sharp": "^0.35.3",
    "vite": "^8.1.1",
    "wrangler": "^4.110.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  }
}
